type Book {
    id: ID!
    title: String!
    author: String!
}

type Query {
    getBooks: [Book]
    getBookById(id: ID!): Book
}

type Mutation {
    addBook(title: String!, author: String!): Book
    updateBook(id: ID!, title: String, author: String): Book
    deleteBook(id: ID!): Boolean
}

schema {
    query: Query
    mutation: Mutation
}
